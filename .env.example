# Copy to .env and fill in. Never commit .env — it is gitignored.
# Real environment variables always win over values in .env.
#
# SECURITY: file loading is allowlisted to credentials and the model name
# (TYPESAFE_API_KEY, TYPESAFE_DEFAULT_MODEL). TYPESAFE_BASE_URL is
# deliberately NOT loadable from files: a planted .env in a cloned repo
# could otherwise redirect your API key to an attacker's host. Set it in
# your real environment if you need it.
#
# jev-cli also reads a user-level config: ~/.jevcli/jev.conf (same format,
# same allowlist, keep it chmod 600). Precedence: jev.conf < ./.env < real
# environment < CLI flags.

# Required. Get one at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=apikey_...

# Optional: model alias (default: jev-latest)
# TYPESAFE_DEFAULT_MODEL=jev-latest
